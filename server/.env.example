# Copie ce fichier en ".env" et remplis tes vraies valeurs.
# Ne commite JAMAIS le fichier .env (il est déjà dans .gitignore).

# --- Général ---
PORT=4000
# URL publique du FRONTEND (utilisée pour construire les liens de retour
# success_url / cancel_url après paiement).
APP_BASE_URL=http://localhost:5173
# Origine autorisée pour les requêtes CORS depuis le frontend.
CORS_ORIGIN=http://localhost:5173

# --- Wave (https://docs.wave.com — Wave for Business) ---
# Clé API secrète de ton compte Wave Business (Checkout API).
WAVE_API_KEY=

# --- Orange Money (https://developer.orange.com — Orange Money Web Payment) ---
# Identifiants OAuth de ton application sur le portail développeur Orange.
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
# Clé marchand fournie par Orange Money lors de la signature du contrat.
ORANGE_MONEY_MERCHANT_KEY=
# Code pays utilisé dans l'URL de l'API (ci = Côte d'Ivoire).
ORANGE_MONEY_COUNTRY=ci

# --- Email (formulaire de contact) ---
# N'importe quel fournisseur SMTP (Gmail avec mot de passe d'application,
# Brevo, SendGrid, Mailgun, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_TO_EMAIL=
